ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LLM_PROVIDER=ANTHROPIC
ANTHROPIC_MODEL=claude-sonnet-4-6
GOOGLE_MODEL=gemini-3.1-flash-lite
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=False
APP_TIMEZONE=Asia/Kolkata
SIMULATE_WRITES_ONLY=True
RATE_LIMIT_PER_MINUTE=10

# Set LLM_PROVIDER=GOOGLE to use Google Gemini via google-genai.
# Ensure GOOGLE_API_KEY is populated before switching providers.

